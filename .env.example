# Lösenord för MariaDB-root (behövs bara av Docker-containern)
DB_ROOT_PASSWORD=changeme_root

# Applikationsanvändare – används av Next.js och PS1-skriptet
DB_USER=vpnuser
DB_PASSWORD=changeme
DB_NAME=vpn_logs

# Hur ofta dashboarden uppdaterar sig (millisekunder)
NEXT_PUBLIC_REFRESH_INTERVAL=30000
